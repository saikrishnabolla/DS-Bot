node_modules/
*.tgz
# The desktop app's window build (npm run build in app/), its packages (npm run pack, npm run dist)
# and the next version that checks its update (see app/README.md). The Office runtime payload
# (npm run runtime in app/) is downloaded per machine.
/app/ui/dist/
/app/dist-pack/
/app/dist-next/
/app/build/runtime/
/app/build/runtime-cache/
/app/build/preload.cjs

# Local screenshots.
/shots/
.playwright-mcp/

# Extra patterns for scripts/scan.mjs that must not be named in the repository.
.scan-extra

# Persistent data for start.ps1 (profiles, credentials, chats and Bot files).
/.ds-bot-local/

# Local Docker deployment data.
/docker/data/
/docker/workspace/
/docker/.env
/.env
/docker-compose.override.yml

# Bytecode from the record-browser-gif encoder's local media tests.
__pycache__/
