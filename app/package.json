{
  "name": "dsbot",
  "productName": "DS Bot",
  "version": "0.3.2",
  "private": true,
  "description": "DS Bot desktop app running the owned Pi Durable host.",
  "author": "Fei2411",
  "homepage": "https://github.com/Fei2411/DS-Bot",
  "desktopName": "dsbot.desktop",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "build": "vite build && node scripts/build-preload.mjs",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "check-packed": "node scripts/check-packed.mjs",
    "check-speech": "node scripts/check-speech.mjs",
    "check-lifecycle": "node scripts/check-lifecycle.mjs",
    "shot": "node scripts/shot.mjs",
    "icon": "node scripts/icon.mjs",
    "test": "node --test \"test/*.test.mjs\" \"ui/test/*.test.js\""
  },
  "dependencies": {
    "@trycua/cua-driver": "0.46.0",
    "ds-bot": "file:../ds-bot",
    "electron-updater": "6.8.10",
    "qrcode-generator": "2.0.4",
    "sherpa-onnx-node": "1.13.8",
    "ws": "8.21.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vite": "8.3.4"
  }
}
